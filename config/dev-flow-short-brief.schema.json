{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kuzai.org/schemas/dev-flow-short-brief-v1.json",
  "title": "Mini-Kuzai DEV-FLOW Short Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "step",
    "video_id",
    "source",
    "timeline",
    "narration",
    "youtube"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "step": {
      "type": "string",
      "pattern": "^V[0-9]+$"
    },
    "video_id": {
      "type": "string",
      "pattern": "^VIDEO-V[0-9]+-FINAL$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "final_receipt",
        "gogit_report",
        "source_commit",
        "final_status"
      ],
      "properties": {
        "final_receipt": {
          "type": "string",
          "pattern": "^automation/dev-flow/receipts/V[0-9]+-final\\.json$"
        },
        "gogit_report": {
          "type": "string",
          "pattern": "^reports/assistant-results/history/PHASE03-SMOLTALK-V[0-9]+-.+\\.json$"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "final_status": {
          "const": "PUBLISHED"
        }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_seconds",
        "segments"
      ],
      "properties": {
        "duration_seconds": {
          "const": 60
        },
        "segments": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "duration_seconds",
              "badge",
              "headline",
              "body"
            ],
            "properties": {
              "duration_seconds": {
                "const": 12
              },
              "badge": {
                "type": "string",
                "maxLength": 24
              },
              "headline": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "body": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
              }
            }
          }
        }
      }
    },
    "narration": {
      "type": "string",
      "minLength": 80,
      "maxLength": 900
    },
    "youtube": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "tags",
        "publication_mode"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 5000
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          }
        },
        "publication_mode": {
          "const": "public"
        }
      }
    }
  }
}
