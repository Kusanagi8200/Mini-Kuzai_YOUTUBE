{
  "schema_version": 3,
  "canvas": {
    "width": 1080,
    "height": 1920
  },
  "policy": {
    "coordinate_origin": "top-left",
    "units": "pixels",
    "dynamic_text_policy": "footer-centered-sequential-text",
    "text_frame": false,
    "static_github_footer": true
  },
  "reserved_zones": {
    "fixed_logo": { "x": 40, "y": 60, "width": 260, "height": 280 },
    "character_protection": { "x": 220, "y": 340, "width": 620, "height": 900 },
    "fixed_branding": { "x": 120, "y": 1260, "width": 840, "height": 240 },
    "shorts_right_ui_conservative": { "x": 900, "y": 300, "width": 180, "height": 1200 }
  },
  "dynamic_zones": {
    "footer":   { "x": 70,  "y": 1455, "width": 940, "height": 250 },
    "badge":    { "x": 120, "y": 1460, "width": 840, "height": 42 },
    "headline": { "x": 80,  "y": 1510, "width": 920, "height": 82 },
    "body":     { "x": 80,  "y": 1595, "width": 920, "height": 72 }
  },
  "static_footer": {
    "enabled": true,
    "text": "GITHUB.COM/KUSANAGI8200",
    "box": { "x": 250, "y": 1765, "width": 580, "height": 64 },
    "font_px": 28,
    "text_color": "#FFFFFF",
    "background_color": "#000000",
    "stroke_px": 0
  },
  "typography": {
    "family": "Ubuntu Sans",
    "style": "Bold",
    "badge_px": 34,
    "headline_px": 58,
    "body_px": 40,
    "stroke_px": 4,
    "text_alignment": "center"
  },
  "text_style": {
    "text": "#F2F2F2",
    "stroke": "#000000"
  }
}
