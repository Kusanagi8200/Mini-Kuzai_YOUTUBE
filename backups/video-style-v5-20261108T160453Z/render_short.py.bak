#!/usr/bin/env python3
"""Deterministic 1080x1920 / 60-second Mini-Kuzai video renderer."""

from __future__ import annotations

import argparse
import json
import shutil
import subprocess
import tempfile
from pathlib import Path

from PIL import Image, ImageDraw, ImageFont

ROOT = Path(__file__).resolve().parents[1]
BACKGROUND = ROOT / "assets" / "backgrounds" / "mini-kuzai-short-master.png"
LAYOUT = ROOT / "config" / "overlay-layout.json"
DEFAULT_TIMELINE = ROOT / "config" / "video001-intro-render-test.json"
TARGET_DURATION = 60.0
FPS = 30


def run(args: list[str]) -> str:
    result = subprocess.run(
        args,
        cwd=ROOT,
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or result.stdout.strip())
    return result.stdout.strip()


def resolve_font() -> Path:
    output = run(["fc-match", "-f", "%{file}", "Ubuntu Sans:style=Bold"])
    font = Path(output)
    if not font.is_file():
        raise RuntimeError(f"Ubuntu Sans Bold font not found: {font}")
    return font


def load_json(path: Path) -> dict:
    return json.loads(path.read_text(encoding="utf-8"))


def validate_timeline(timeline: dict) -> None:
    duration = float(timeline.get("duration_seconds", 0))
    segments = timeline.get("segments", [])
    segment_total = sum(float(item.get("duration_seconds", 0)) for item in segments)
    if abs(duration - TARGET_DURATION) > 0.001:
        raise ValueError(f"Timeline duration must be {TARGET_DURATION:.0f}s")
    if abs(segment_total - TARGET_DURATION) > 0.001:
        raise ValueError(f"Segment total must be {TARGET_DURATION:.0f}s, got {segment_total}")
    if not segments:
        raise ValueError("Timeline must contain at least one segment")


def hex_rgba(value: str) -> tuple[int, int, int, int]:
    raw = value.strip().lstrip("#")
    if len(raw) != 6:
        raise ValueError(f"Invalid color: {value}")
    return tuple(int(raw[i:i + 2], 16) for i in (0, 2, 4)) + (255,)


def fit_font(
    draw: ImageDraw.ImageDraw,
    text: str,
    font_path: Path,
    start_size: int,
    max_width: int,
    max_height: int,
    stroke_width: int,
    min_size: int = 20,
) -> ImageFont.FreeTypeFont:
    for size in range(start_size, min_size - 1, -2):
        font = ImageFont.truetype(str(font_path), size=size)
        box = draw.textbbox((0, 0), text, font=font, stroke_width=stroke_width)
        if box[2] - box[0] <= max_width and box[3] - box[1] <= max_height:
            return font
    return ImageFont.truetype(str(font_path), size=min_size)


def draw_center_text(
    draw: ImageDraw.ImageDraw,
    zone: dict,
    text: str,
    font_path: Path,
    start_size: int,
    fill: tuple[int, int, int, int],
    stroke_fill: tuple[int, int, int, int],
    stroke_width: int,
) -> None:
    if not text:
        return

    font = fit_font(
        draw,
        text,
        font_path,
        start_size,
        zone["width"],
        zone["height"],
        stroke_width,
    )
    box = draw.textbbox((0, 0), text, font=font, stroke_width=stroke_width)
    width = box[2] - box[0]
    height = box[3] - box[1]
    x = zone["x"] + (zone["width"] - width) / 2 - box[0]
    y = zone["y"] + (zone["height"] - height) / 2 - box[1]

    draw.text(
        (x, y),
        text,
        font=font,
        fill=fill,
        stroke_width=stroke_width,
        stroke_fill=stroke_fill,
    )


def draw_static_footer(
    draw: ImageDraw.ImageDraw,
    layout: dict,
    font_path: Path,
) -> None:
    static_footer = layout.get("static_footer", {})
    if not static_footer.get("enabled", False):
        return

    box = static_footer["box"]
    text = static_footer["text"]
    bg_color = hex_rgba(static_footer["background_color"])
    text_color = hex_rgba(static_footer["text_color"])
    stroke_width = int(static_footer.get("stroke_px", 0))

    x0 = box["x"]
    y0 = box["y"]
    x1 = x0 + box["width"]
    y1 = y0 + box["height"]

    draw.rectangle((x0, y0, x1, y1), fill=bg_color)

    draw_center_text(
        draw,
        box,
        text,
        font_path,
        int(static_footer["font_px"]),
        text_color,
        text_color,
        stroke_width,
    )


def render_frame(
    background: Image.Image,
    layout: dict,
    segment: dict,
    font_path: Path,
    output: Path,
) -> None:
    frame = background.convert("RGBA")
    overlay = Image.new("RGBA", frame.size, (0, 0, 0, 0))
    draw = ImageDraw.Draw(overlay)

    zones = layout["dynamic_zones"]
    typography = layout["typography"]
    text_style = layout["text_style"]

    text_color = hex_rgba(text_style["text"])
    stroke_color = hex_rgba(text_style["stroke"])
    stroke_width = int(typography["stroke_px"])

    draw_center_text(
        draw,
        zones["badge"],
        segment.get("badge", ""),
        font_path,
        int(typography["badge_px"]),
        text_color,
        stroke_color,
        stroke_width,
    )
    draw_center_text(
        draw,
        zones["headline"],
        segment.get("headline", ""),
        font_path,
        int(typography["headline_px"]),
        text_color,
        stroke_color,
        stroke_width,
    )
    draw_center_text(
        draw,
        zones["body"],
        segment.get("body", ""),
        font_path,
        int(typography["body_px"]),
        text_color,
        stroke_color,
        stroke_width,
    )

    draw_static_footer(draw, layout, font_path)

    Image.alpha_composite(frame, overlay).convert("RGB").save(output, "PNG")


def encode(frames: list[tuple[Path, float]], output: Path) -> None:
    ffmpeg = shutil.which("ffmpeg")
    if not ffmpeg:
        raise RuntimeError("ffmpeg not found")

    args = [ffmpeg, "-y"]
    for frame, duration in frames:
        args.extend([
            "-loop", "1",
            "-framerate", str(FPS),
            "-t", f"{duration:.3f}",
            "-i", str(frame),
        ])

    streams = "".join(f"[{idx}:v]" for idx in range(len(frames)))
    filter_complex = (
        f"{streams}concat=n={len(frames)}:v=1:a=0,"
        f"fps={FPS},format=yuv420p[v]"
    )

    args.extend([
        "-filter_complex", filter_complex,
        "-map", "[v]",
        "-an",
        "-c:v", "libx264",
        "-preset", "medium",
        "-crf", "18",
        "-movflags", "+faststart",
        "-t", f"{TARGET_DURATION:.3f}",
        str(output),
    ])
    run(args)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--timeline", type=Path, default=DEFAULT_TIMELINE)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--keep-frames", action="store_true")
    args = parser.parse_args()

    timeline = load_json(args.timeline)
    layout = load_json(LAYOUT)
    validate_timeline(timeline)

    background = Image.open(BACKGROUND)
    canvas = layout["canvas"]
    if background.size != (canvas["width"], canvas["height"]):
        raise RuntimeError(
            f"Background size {background.size} does not match "
            f"{canvas['width']}x{canvas['height']}"
        )

    font_path = resolve_font()
    args.output.parent.mkdir(parents=True, exist_ok=True)

    temp_root = ROOT / "work"
    temp_root.mkdir(parents=True, exist_ok=True)
    temp_dir = Path(tempfile.mkdtemp(prefix="renderer-", dir=temp_root))

    try:
        frames: list[tuple[Path, float]] = []
        for index, segment in enumerate(timeline["segments"]):
            frame = temp_dir / f"segment-{index:02d}.png"
            render_frame(background, layout, segment, font_path, frame)
            frames.append((frame, float(segment["duration_seconds"])))
        encode(frames, args.output)
    finally:
        if not args.keep_frames:
            shutil.rmtree(temp_dir, ignore_errors=True)

    print(f"OUTPUT={args.output}")
    print(f"DURATION_SECONDS={TARGET_DURATION:.0f}")
    print(f"FPS={FPS}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
