#!/usr/bin/env python3
"""Deterministic 1080x1920 / 60-second Mini-Kuzai video renderer."""

from __future__ import annotations

import argparse
import json
import shutil
import subprocess
import tempfile
from pathlib import Path

from PIL import Image, ImageDraw, ImageFont

ROOT = Path(__file__).resolve().parents[1]
BACKGROUND = ROOT / "assets" / "backgrounds" / "mini-kuzai-short-master.png"
LAYOUT = ROOT / "config" / "overlay-layout.json"
DEFAULT_TIMELINE = ROOT / "config" / "video001-intro-render-test.json"
TARGET_DURATION = 60.0
FPS = 30


def run(args: list[str]) -> str:
    result = subprocess.run(
        args,
        cwd=ROOT,
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or result.stdout.strip())
    return result.stdout.strip()


def resolve_font(layout: dict) -> tuple[Path, str]:
    preferences = layout.get("font_preferences", [])
    for item in preferences:
        candidate = ROOT / item
        if candidate.is_file():
            return candidate, str(candidate)

        try:
            family = run(["fc-match", "-f", "%{family}", item])
            path = Path(run(["fc-match", "-f", "%{file}", item]))
        except Exception:
            continue

        if path.is_file():
            families = [x.strip().lower() for x in family.split(",")]
            wanted = item.lower()
            if (
                "anta" in wanted and any("anta" in f for f in families)
            ) or (
                "ubuntu sans" in wanted and any("ubuntu sans" in f for f in families)
            ) or (
                ":" not in item and any(wanted in f for f in families)
            ):
                return path, item

    fallback = Path(run(["fc-match", "-f", "%{file}", "Ubuntu Sans:style=Bold"]))
    if not fallback.is_file():
        raise RuntimeError("No usable font found")
    return fallback, "Ubuntu Sans:style=Bold"


def load_json(path: Path) -> dict:
    return json.loads(path.read_text(encoding="utf-8"))


def validate_timeline(timeline: dict) -> None:
    duration = float(timeline.get("duration_seconds", 0))
    segments = timeline.get("segments", [])
    segment_total = sum(float(item.get("duration_seconds", 0)) for item in segments)
    if abs(duration - TARGET_DURATION) > 0.001:
        raise ValueError(f"Timeline duration must be {TARGET_DURATION:.0f}s")
    if abs(segment_total - TARGET_DURATION) > 0.001:
        raise ValueError(f"Segment total must be {TARGET_DURATION:.0f}s, got {segment_total}")
    if not segments:
        raise ValueError("Timeline must contain at least one segment")


def hex_rgba(value: str) -> tuple[int, int, int, int]:
    raw = value.strip().lstrip("#")
    if len(raw) != 6:
        raise ValueError(f"Invalid color: {value}")
    return tuple(int(raw[i:i + 2], 16) for i in (0, 2, 4)) + (255,)


def fit_font(
    draw: ImageDraw.ImageDraw,
    text: str,
    font_path: Path,
    start_size: int,
    max_width: int,
    max_height: int,
    stroke_width: int,
    min_size: int = 18,
) -> ImageFont.FreeTypeFont:
    for size in range(start_size, min_size - 1, -2):
        font = ImageFont.truetype(str(font_path), size=size)
        box = draw.textbbox((0, 0), text, font=font, stroke_width=stroke_width)
        width = box[2] - box[0]
        height = box[3] - box[1]
        if width <= max_width and height <= max_height:
            return font
    return ImageFont.truetype(str(font_path), size=min_size)


def draw_boxed_center_text(
    draw: ImageDraw.ImageDraw,
    center_x: int,
    top_y: int,
    text: str,
    font_path: Path,
    font_px: int,
    max_text_width: int,
    max_text_height: int,
    text_color: tuple[int, int, int, int],
    background_color: tuple[int, int, int, int],
    stroke_color: tuple[int, int, int, int],
    stroke_width: int,
    padding_x: int,
    padding_y: int,
) -> None:
    if not text:
        return

    font = fit_font(
        draw=draw,
        text=text,
        font_path=font_path,
        start_size=font_px,
        max_width=max_text_width,
        max_height=max_text_height,
        stroke_width=stroke_width,
    )

    box = draw.textbbox((0, 0), text, font=font, stroke_width=stroke_width)
    text_w = box[2] - box[0]
    text_h = box[3] - box[1]

    rect_w = text_w + (padding_x * 2)
    rect_h = text_h + (padding_y * 2)

    rect_x0 = round(center_x - (rect_w / 2))
    rect_y0 = top_y
    rect_x1 = rect_x0 + rect_w
    rect_y1 = rect_y0 + rect_h

    draw.rectangle((rect_x0, rect_y0, rect_x1, rect_y1), fill=background_color)

    text_x = rect_x0 + padding_x - box[0]
    text_y = rect_y0 + padding_y - box[1]

    draw.text(
        (text_x, text_y),
        text,
        font=font,
        fill=text_color,
        stroke_width=stroke_width,
        stroke_fill=stroke_color,
    )


def render_frame(
    background: Image.Image,
    layout: dict,
    segment: dict,
    font_path: Path,
    output: Path,
) -> None:
    frame = background.convert("RGBA")
    overlay = Image.new("RGBA", frame.size, (0, 0, 0, 0))
    draw = ImageDraw.Draw(overlay)

    elements = layout["elements"]

    render_order = [
        ("static_title", elements["static_title"].get("text", "")),
        ("dynamic_badge", segment.get(elements["dynamic_badge"].get("field", ""), "")),
        ("dynamic_headline", segment.get(elements["dynamic_headline"].get("field", ""), "")),
        ("dynamic_body", segment.get(elements["dynamic_body"].get("field", ""), "")),
        ("github_footer", elements["github_footer"].get("text", "")),
    ]

    for key, text in render_order:
        config = elements[key]
        if not config.get("enabled", False):
            continue
        if not text:
            continue

        draw_boxed_center_text(
            draw=draw,
            center_x=int(config["center_x"]),
            top_y=int(config["top_y"]),
            text=text,
            font_path=font_path,
            font_px=int(config["font_px"]),
            max_text_width=int(config["max_text_width"]),
            max_text_height=int(config["max_text_height"]),
            text_color=hex_rgba(config["text_color"]),
            background_color=hex_rgba(config["background_color"]),
            stroke_color=hex_rgba(config["stroke_color"]),
            stroke_width=int(config["stroke_px"]),
            padding_x=int(config["padding_x"]),
            padding_y=int(config["padding_y"]),
        )

    Image.alpha_composite(frame, overlay).convert("RGB").save(output, "PNG")


def encode(frames: list[tuple[Path, float]], output: Path) -> None:
    ffmpeg = shutil.which("ffmpeg")
    if not ffmpeg:
        raise RuntimeError("ffmpeg not found")

    args = [ffmpeg, "-y"]
    for frame, duration in frames:
        args.extend([
            "-loop", "1",
            "-framerate", str(FPS),
            "-t", f"{duration:.3f}",
            "-i", str(frame),
        ])

    streams = "".join(f"[{idx}:v]" for idx in range(len(frames)))
    filter_complex = (
        f"{streams}concat=n={len(frames)}:v=1:a=0,"
        f"fps={FPS},format=yuv420p[v]"
    )

    args.extend([
        "-filter_complex", filter_complex,
        "-map", "[v]",
        "-an",
        "-c:v", "libx264",
        "-preset", "medium",
        "-crf", "18",
        "-movflags", "+faststart",
        "-t", f"{TARGET_DURATION:.3f}",
        str(output),
    ])
    run(args)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--timeline", type=Path, default=DEFAULT_TIMELINE)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--keep-frames", action="store_true")
    args = parser.parse_args()

    timeline = load_json(args.timeline)
    layout = load_json(LAYOUT)
    validate_timeline(timeline)

    background = Image.open(BACKGROUND)
    canvas = layout["canvas"]
    if background.size != (canvas["width"], canvas["height"]):
        raise RuntimeError(
            f"Background size {background.size} does not match "
            f"{canvas['width']}x{canvas['height']}"
        )

    font_path, font_label = resolve_font(layout)

    args.output.parent.mkdir(parents=True, exist_ok=True)

    temp_root = ROOT / "work"
    temp_root.mkdir(parents=True, exist_ok=True)
    temp_dir = Path(tempfile.mkdtemp(prefix="renderer-", dir=temp_root))

    try:
        frames: list[tuple[Path, float]] = []
        for index, segment in enumerate(timeline["segments"]):
            frame = temp_dir / f"segment-{index:02d}.png"
            render_frame(background, layout, segment, font_path, frame)
            frames.append((frame, float(segment["duration_seconds"])))
        encode(frames, args.output)
    finally:
        if not args.keep_frames:
            shutil.rmtree(temp_dir, ignore_errors=True)

    print(f"OUTPUT={args.output}")
    print(f"DURATION_SECONDS={TARGET_DURATION:.0f}")
    print(f"FPS={FPS}")
    print(f"FONT_USED={font_label}")
    print(f"FONT_PATH={font_path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
